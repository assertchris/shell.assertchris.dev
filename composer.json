{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "assertchris/shell",
    "type": "project",
    "description": "A read-only proxy between personal assistants and external services.",
    "keywords": ["laravel", "proxy", "assistants"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "assertchris/cloudflare-security-rule-sync": "1.0.1",
        "barryvdh/laravel-ide-helper": "3.7.0",
        "directorytree/imapengine-laravel": "1.3.0",
        "filament/filament": "5.8.4",
        "google/apiclient": "2.20.0",
        "laravel/framework": "13.33.0",
        "laravel/sanctum": "4.3.3",
        "laravel/socialite": "5.31.0",
        "laravel/tinker": "3.0.2",
        "socialiteproviders/slack": "5.2.0"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "laravel/boost": "2.10.0",
        "laravel/pint": "1.32.1",
        "mockery/mockery": "1.6.15",
        "nunomaduro/collision": "8.9.5",
        "pestphp/pest": "5.2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "clear-caches": [
            "rm -Rf ./bootstrap/cache/*.php",
            "@php artisan cache:clear",
            "@php artisan route:clear",
            "@php artisan view:clear",
            "@php artisan config:clear",
            "@php artisan clear-compiled"
        ],
        "format": [
            "vendor/bin/pint --config meta/pint.json"
        ],
        "refresh-ide-helpers": [
            "@clear-caches",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@format"
        ],
        "refresh-ide-model-docblock": [
            "@clear-caches",
            "@php artisan ide-helper:models --write --reset",
            "@format"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
